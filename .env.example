SLACK_USER_ID=U0000000000
SLOPERATOR_SLACK_BOT_TOKEN=xoxb-replace-me
SLOPERATOR_SLACK_BOT_SOCKET_TOKEN_ID=xapp-replace-me

# Optional
SLOPERATOR_HOST=127.0.0.1
SLOPERATOR_PORT=8080
SLOPERATOR_LOG_LEVEL=INFO
SLOPERATOR_DATABASE_PATH=data/sloperator.sqlite3
SLOPERATOR_BACKFILL_LIMIT=100
SLOPERATOR_SYNC_INTERVAL_SECONDS=300

# Agent sessions for non-command DMs
SLOPERATOR_AGENT_WORKSPACE=/home/egor/projects/ug-ai-analyst
SLOPERATOR_DEFAULT_AGENT=claude
SLOPERATOR_CLAUDE_MODEL=opus
SLOPERATOR_CODEX_MODEL=gpt-5.6-sol
SLOPERATOR_CLAUDE_CLI=/home/egor/.local/bin/claude
SLOPERATOR_CODEX_CLI=/usr/bin/codex
SLOPERATOR_AGENT_TIMEOUT_SECONDS=1800
SLOPERATOR_AGENT_MAX_CONCURRENCY=2

# Isolated corporate VPN (optional)
LDAP_USERNAME='user@example.com'
LDAP_PASSWORD='replace-me'
SLOPERATOR_VPN_PROFILE='/home/egor/hz config 2fa.ovpn'
SLOPERATOR_VPN_IMAGE=local/openvpn-agent:24.04
SLOPERATOR_VPN_CONTAINER=sloperator-vpn
SLOPERATOR_VPN_PROXY_PORT=18888
