[Unit]
Description=Sloperator Slack bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=egor
Group=egor
SupplementaryGroups=docker systemd-journal
WorkingDirectory=/home/egor/projects/11x-sloperator-app
EnvironmentFile=/home/egor/projects/11x-sloperator-app/.env
ExecStart=/home/egor/projects/11x-sloperator-app/.venv/bin/sloperator
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=/home/egor/projects/11x-sloperator-app/.env
ReadWritePaths=/home/egor/projects/11x-sloperator-app/data
ReadWritePaths=/home/egor/projects/ug-ai-analyst
ReadWritePaths=/home/egor/.claude
ReadWritePaths=/home/egor/.claude.json
ReadWritePaths=/home/egor/.codex
ReadWritePaths=-/home/egor/.cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
SystemCallArchitectures=native
TasksMax=256
MemoryMax=1536M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
